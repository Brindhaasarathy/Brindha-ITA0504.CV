
import cv2

# Read the source image
img = cv2.imread("input.jpg")

if img is None:
    print("Error: Image not found!")
    exit()

# Display source image
cv2.imshow("Source Image", img)

# Select ROI using mouse
roi = cv2.selectROI("Source Image", img,
                    fromCenter=False,
                    showCrosshair=True)

# Get ROI coordinates
x, y, w, h = roi

# Check whether ROI is selected
if w > 0 and h > 0:

    # Crop the selected region
    cropped = img[y:y+h, x:x+w]

    # Copy the cropped region
    copied = cropped.copy()

    # Display cropped image
    cv2.imshow("Cropped ROI", cropped)

    # Paste ROI at a new location
    paste_x = 50
    paste_y = 50

    # Check destination boundaries
    if (paste_y + h <= img.shape[0] and
        paste_x + w <= img.shape[1]):

        img[paste_y:paste_y+h,
            paste_x:paste_x+w] = copied

        # Display final image
        cv2.imshow("Final Image", img)

        # Save final output
        cv2.imwrite("output.jpg", img)

        print("ROI cropped, copied and pasted successfully!")
        print("Output saved as output.jpg")

    else:
        print("Error: Paste location is outside image boundaries.")

else:
    print("No ROI selected.")

cv2.waitKey(0)
cv2.destroyAllWindows()
